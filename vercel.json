{
  "version": 2,
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/publish-cricket",
      "schedule": "5 18 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" }
  ]
}
